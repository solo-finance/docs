              "products/bank-specific-bad-actor-list",
              "products/cross-bank-financial-crimes-watch-list"
            ]
          },
          {
            "group": "Utilities",
            "pages": [
              "products/coverage-check"
            ]
          }
        ]
      },
      {
        "tab": "Concepts",
        "groups": [
          {
            "group": "Trust model",
            "pages": [
              "concepts/trust/trust-assets",
              "concepts/trust/consumer-graph",
              "concepts/trust/business-graph",
              "concepts/trust/provenance"
            ]
          },
          {
            "group": "Networks & Governance",
            "pages": [
              "concepts/governance/networks",
              "concepts/governance/network-roles",
              "concepts/governance/entitlement",
              "concepts/governance/querying-policies",
              "concepts/governance/furnishing-policies"
            ]
          },
          {
            "group": "Entities & Consent",
            "pages": [
              "concepts/identity/entities",
              "concepts/identity/consent"
            ]
          }
        ]
      },
      {
        "tab": "API Overview",
        "groups": [
          {
            "group": "Furnishing API",
            "pages": [
              "api-overview/furnishing/overview",
              "api-overview/furnishing/file-upload",
              {
                "group": "SFTP Ingestion",
                "pages": [
                  "api-overview/sftp/getting-started",
                  "api-overview/sftp/overview"
                ]
              }
            ]
          },
          {
            "group": "Query API",
            "pages": [
              "api-overview/querying/overview",
              "api-overview/querying/products",
              "api-overview/querying/kyc-certificate-snapshot",
              "api-overview/querying/kyb-certificate-snapshot",
