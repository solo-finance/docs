          },
          {
            "group": "KYC Certificate Snapshot",
            "pages": [
              "api-reference/kyc-certificate-snapshot/query",
              "api-reference/kyc-certificate-snapshot/soft",
              "api-reference/kyc-certificate-snapshot/furnish"
            ]
          },
          {
            "group": "KYB Certificate Snapshot",
            "pages": [
              "api-reference/kyb-certificate-snapshot/query",
              "api-reference/kyb-certificate-snapshot/soft",
              "api-reference/kyb-certificate-snapshot/furnish"
            ]
          },
          {
            "group": "Bank-Specific Bad Actor List",
            "pages": [
              "api-reference/bank-specific-bad-actor-list/query"
            ]
          },
          {
            "group": "Cross-Bank Financial Crimes Watch List",
            "pages": [
