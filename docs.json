{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "SOLO Network API",
  "colors": {
    "primary": "#18181B",
    "light": "#18181B",
    "dark": "#FAFAFA"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#09090B"
    }
  },
  "font": {
    "headings": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "rounded": "default",
  "css": "/custom.css",
  "favicon": "/favicon.svg",
  "openapi": [
    "/api-reference/openapi.json"
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Home",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "home/welcome",
              "home/why-solo",
              "home/overview",
              "home/authentication",
              "home/errors",
              "home/security"
            ]
          },
          {
            "group": "Quickstart",
            "pages": [
              "home/quickstart",
              "home/quickstart/furnish-an-entity",
              "home/quickstart/query-a-product",
              "home/quickstart/join-a-network"
            ]
          },
          {
            "group": "Golden paths",
            "pages": [
              "home/golden-paths/overview",
              "home/golden-paths/sponsor-banks",
              "home/golden-paths/fintechs"
            ]
          }
        ]
      },
      {
        "tab": "Products",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "products/overview"
            ]
          },
          {
            "group": "Catalog",
            "pages": [
              "products/kyc-certificate-snapshot",
