          {
            "group": "Furnishing — Mapping Dry-Run",
            "pages": [
              "api-reference/furnishing-mapping-dry-run/verify",
              "api-reference/furnishing-mapping-dry-run/trace",
              "api-reference/furnishing-mapping-dry-run/suggest",
              "api-reference/furnishing-mapping-dry-run/propose"
