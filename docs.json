{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "SOLO Network API",
  "colors": {
    "primary": "#18181B",
    "light": "#18181B",
    "dark": "#FAFAFA"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#09090B"
    }
  },
  "font": {
    "headings": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "rounded": "default",
  "css": "/custom.css",
  "favicon": "/favicon.svg",
  "openapi": [
    "/api-reference/openapi.json"
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "welcome",
              "authentication",
              "errors"
            ]
          },
          {
            "group": "Quickstart",
            "pages": [
              "quickstart",
              "quickstart/furnish-an-entity",
              "quickstart/query-a-product",
              "quickstart/join-a-network"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/overview",
              "concepts/entities",
              "concepts/consent",
              "concepts/products",
              "concepts/policies",
              "concepts/networks",
              "concepts/entitlement",
              "concepts/querying",
              "concepts/furnishing"
            ]
          }
        ]
      },
      {
        "tab": "SFTP",
        "groups": [
          {
            "group": "SFTP Ingestion",
            "pages": [
              "sftp/getting-started",
              "sftp/overview",
              "sftp/csv-format",
              "sftp/schemas"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Consent",
            "pages": [
              "api-reference/consumer/consumer",
              "api-reference/consumer/{consent_id}",
              "api-reference/business/business"
            ]
          },
          {
            "group": "Entities",
            "pages": [
              "api-reference/entities/consumer-search",
              "api-reference/entities/business-search"
            ]
          },
          {
            "group": "Products",
            "pages": [
              {
                "group": "KYC Certificate",
                "pages": [
                  "api-reference/kyc-certificate/query",
                  "api-reference/kyc-certificate/furnish",
                  "api-reference/kyc-certificate/furnish_via_upload"
                ]
              },
              {
                "group": "KYB Certificate",
                "pages": [
                  "api-reference/kyb-certificate/query",
                  "api-reference/kyb-certificate/furnish",
                  "api-reference/kyb-certificate/furnish_via_upload"
                ]
              },
              {
                "group": "Screening Lists",
                "pages": [
                  "api-reference/bank-specific-bad-actor-list/query",
                  "api-reference/cross-bank-financial-crimes-watch-list/query"
                ]
              }
            ]
          },
          {
            "group": "Policies",
            "pages": [
              "api-reference/querying-policies/querying",
              "api-reference/querying-policies/configuration",
              "api-reference/furnishing-policies/furnishing",
              "api-reference/furnishing-policies/{policy_id}"
            ]
          },
          {
            "group": "Attestations",
            "pages": [
              "api-reference/institution-attestation/institution-attestation"
            ]
          },
          {
            "group": "Bulk Ingestion",
            "pages": [
              "api-reference/file-upload/ingest"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "footer": {
    "socials": {
      "github": "https://github.com/solo-finance"
    }
  }
}
