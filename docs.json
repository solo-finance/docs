  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "footer": {
    "socials": {
      "github": "https://github.com/solo-finance"
    }
  },
  "redirects": [
    {
      "source": "/api-reference/business-identity/business_identity",
      "destination": "/api-reference/business-identity/business-identity"
    },
    {
      "source": "/api-reference/consumer-identity/consumer_identity",
      "destination": "/api-reference/consumer-identity/consumer-identity"
    },
    {
      "source": "/api-reference/consumer-identity/{consent_id}",
      "destination": "/api-reference/consumer-identity/get-consumer-identity-consent-id"
    },
    {
      "source": "/api-reference/entities/search",
      "destination": "/api-reference/entities/get-consumer-identity-search"
    },
    {
      "source": "/api-reference/furnishing-policies/{policy_id}",
      "destination": "/api-reference/furnishing-policies/policy-id"
    },
    {
      "source": "/api-reference/furnishing-—-mapping-dry-run/:slug",
      "destination": "/api-reference/furnishing-mapping-dry-run/:slug"
    },
    {
      "source": "/api-reference/graph/{object_id}",
      "destination": "/api-reference/graph/object-id"
    },
    {
      "source": "/api-reference/graph/{resource}",
      "destination": "/api-reference/graph/resource"
    },
    {
      "source": "/api-reference/products/check",
      "destination": "/api-reference/product-coverage-check/check"
    },
    {
      "source": "/products/confirmed-fraud-attribute-list",
      "destination": "/products/overview"
    },
    {
      "source": "/api-overview/index-microservice/overview",
      "destination": "/api-overview/furnishing/overview"
    },
    {
      "source": "/api-overview/collect-sdk/overview",
      "destination": "/home/quickstart"
    },
    {
      "source": "/concepts/governance/network-governance",
      "destination": "/concepts/governance/networks"
    },
    {
      "source": "/home/quickstart/network-consumption",
      "destination": "/home/golden-paths/fintechs"
    },
    {
      "source": "/home/quickstart/business-lending-onboarding",
      "destination": "/home/golden-paths/fintechs"
    }
  ]
}
